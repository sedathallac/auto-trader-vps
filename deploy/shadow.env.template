# /etc/auto_trader/shadow.env — FAZ9 SHADOW (ters strateji gozlemi). chmod 600 root:root.
# Kopyalamak icin: install -m 600 -o root -g root deploy/shadow.env.template /etc/auto_trader/shadow.env
# Bu servis EMIR GONDERMEZ: HB_OFFLINE=1 + LIVE_DRY_RUN=1. Yalniz signal_outcomes'a yazar.

# --- mod: compare (HB_OFFLINE=1) ---
HB_OFFLINE=1
COMPARE_MODE=1
LIVE_MODE=0
LIVE_DRY_RUN=1

# --- Faz6: ters politika ACIK (REVERSE_POLICY=on) ---
STRATEGY_CONFIRMATION=compare
REVERSE_POLICY=on
WHALE_HUNTING=compare

# --- kalibrasyon: compare'in biriktirdigi cozulmus satirlar (salt-okunur) ---
SIGNAL_CALIBRATION_DB=/var/lib/auto_trader_faz9/signal_outcomes.db

# --- tarama evreni + yon baraji (live ile ayni) ---
TOP_N=6
LONG_ON_DIP_PCT=-1.0
SHORT_ON_PUMP_PCT=1.0
MIN_VOLUME_USDT=50000000
MIN_PCT_CHANGE=1.0
MAX_PCT_CHANGE=15.0
