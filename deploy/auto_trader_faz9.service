[Unit]
Description=Auto Trader FAZ9 (compare veri toplama, HB_OFFLINE, GERCEK EMIR YOK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/auto_trader_faz9/app
Environment=HOME=/var/lib/auto_trader_faz9
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/auto_trader/auto_trader.env
EnvironmentFile=/etc/auto_trader/keys.env
# Fail-closed koruma: HB_OFFLINE=1 degilse servis baslamaz.
ExecStartPre=/bin/sh -c "test \"$HB_OFFLINE\" = 1"
ExecStart=/opt/auto_trader_faz9/venv/bin/python /opt/auto_trader_faz9/app/auto_trader.py --loop
Restart=always
RestartSec=10
# Canli /root (risk_ledger.db, .trading_archive.db, .env) bu surece gorunmez.
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/auto_trader_faz9 /opt/auto_trader_faz9
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
