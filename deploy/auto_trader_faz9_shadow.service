[Unit]
Description=Auto Trader FAZ9 SHADOW (HB_OFFLINE=1, ters strateji gozlemi, EMIR YOK)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/auto_trader_faz9/app
# Ayri state dizini: compare ve live'in signal_outcomes/risk_ledger/whale_metrics dosyalarina dokunmaz.
Environment=HOME=/var/lib/auto_trader_faz9_shadow
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/auto_trader/shadow.env
# Fail-closed koruma: HB_OFFLINE=1 degilse shadow servisi BASLAMAZ (compare ile ayni yon).
ExecStartPre=/bin/sh -c "test \"$HB_OFFLINE\" = 1"
ExecStart=/opt/auto_trader_faz9/venv/bin/python /opt/auto_trader_faz9/app/auto_trader.py --loop --interval 30
Restart=always
RestartSec=10
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/auto_trader_faz9_shadow /opt/auto_trader_faz9
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
