# /etc/auto_trader/live.env — FAZ9 LIVE instance. chmod 600 root:root.
# Kopyalamak icin: install -m 600 -o root -g root deploy/live.env.template /etc/auto_trader/live.env
# Degerleri ASLA repoya commit etmeyin; bu dosya yalnizca VPS'te yasar.

# --- mod ---
LIVE_MODE=1
HB_OFFLINE=0
COMPARE_MODE=0
LIVE_DRY_RUN=0

# --- kademe (1=testnet, 2=mainnet mikro, 3=mainnet kucuk, 4=mainnet tam) ---
LIVE_STAGE=1
# Stage >= 2 icin operator onayi zorunlu.
LIVE_STAGE_CONFIRMED=0

# --- borsa ---
BINANCE_TESTNET=1
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com

# --- anahtarlar (BOS BIRAKILACAK; operator doldurur) ---
BINANCE_KEY=
BINANCE_SECRET=

# --- risk limitleri (kademe tavanini ASAMAZ; live_guard reddeder) ---
LIVE_MAX_NOTIONAL_USDT=25
LIVE_DAILY_LOSS_LIMIT_USDT=20
LIVE_LEVERAGE=2
LIVE_MAX_OPEN_POSITIONS=2

# --- strateji ---
# signal_outcomes analizinden cikan kazanan aile. Bos ise canli BASLAMAZ.
LIVE_STRATEGY_FAMILY=
# Yalnizca testnet'te: kazanan kurali gecmemis bir aileyle testnet kosusu.
LIVE_ALLOW_UNPROVEN_FAMILY=0

# --- rejim filtresi ---
# Yalniz bu rejimlerde emir verilir; digerleri signal_outcomes'a yazilir, emir YOK.
# Bos birakilirsa HICBIR emir verilmez (fail-closed).
LIVE_WINNING_REGIMES=range,mid
